# The worker's AppArmor profile (U3531): Docker's docker-default (moby v27.3.1 profiles/apparmor/template.go) with
# one change, so bubblewrap can give each job its own namespaces on a host with
# kernel.apparmor_restrict_unprivileged_userns = 1, without touching that sysctl:
#   «deny mount,»  →  «userns,» «mount,» «pivot_root,»
# The kernel still refuses a mount anywhere but in a mount namespace the job's own user namespace owns (the container
# has no CAP_SYS_ADMIN in the host's), so these reach only what bwrap builds for a job.
# Load on the host (once, and after an edit):  sudo apparmor_parser -r -W /etc/apparmor.d/sykehus-worker
# Use for this one container:                  security_opt: ["apparmor=sykehus-worker", "seccomp=./worker/seccomp.json"]

#include <tunables/global>

profile sykehus-worker flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  userns,
  mount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=sykehus-worker,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=sykehus-worker,
}
