# The route B worker (U3570's site constructions): Python with IfcOpenShell's wheel and numpy, no FreeCAD. Under 1 GB.
FROM python:3.12-slim
RUN pip install --no-cache-dir "ifcopenshell>=0.8.4,<0.9" lark numpy \
 && python -c "import ifcopenshell, ifcopenshell.api, ifcopenshell.geom, json, sys; \
json.dump({'ifcopenshell': ifcopenshell.version, 'python': sys.version.split()[0]}, open('/opt/versions.json', 'w'))" \
 && cat /opt/versions.json
ENV HOME=/tmp
USER 1000
WORKDIR /work
