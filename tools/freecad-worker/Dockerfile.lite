# The route B worker: IfcOpenShell only (no FreeCAD), to measure what that route needs.
FROM mambaorg/micromamba:1.5.10
USER root
RUN micromamba install -y -n base -c conda-forge ifcopenshell numpy \
 && micromamba clean -a -y
ENV PATH=/opt/conda/bin:$PATH HOME=/tmp
RUN python -c "import ifcopenshell, ifcopenshell.api, ifcopenshell.geom, json, sys; \
json.dump({'ifcopenshell': ifcopenshell.version, 'python': sys.version.split()[0]}, open('/opt/versions.json', 'w'))" \
 && cat /opt/versions.json
ENTRYPOINT []
USER 1000
WORKDIR /work
